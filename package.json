{
  "name": "ant-design-boilerplate",
  "version": "1.0.0",
  "description": "ES6 React Ant-Design boilerplate",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "lint": "eslint ./app --ext .js,.jsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "precommit": "cross-env npm run lint && npm test",
    "prepush": "cross-env npm run lint && npm test",
    "heroku-postbuild": "vite build"
  },
  "author": "Etor Diaz <etor.diaz.acha@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@ant-design/icons": "^4.2.2",
    "@redux-devtools/extension": "^3.3.0",
    "antd": "^4.24.16",
    "express": "^4.21.1",
    "lodash.get": "^4.4.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^5.3.4",
    "redux": "^5.0.1",
    "redux-saga": "^1.3.0",
    "reqwest": "^2.0.5",
    "reselect": "^4.1.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.24.7",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.25.3",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rimraf": "^5.0.10",
    "sass": "^1.77.8",
    "vite": "^6.0.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "\\.(css|less|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "modulePathIgnorePatterns": [
      "core"
    ],
    "moduleDirectories": [
      "node_modules"
    ],
    "bail": true,
    "collectCoverageFrom": [
      "app/**/*.{js,jsx}"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}