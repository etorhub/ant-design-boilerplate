{
  "name": "ant-design-boilerplate",
  "version": "1.0.0",
  "description": "ES6 React Ant-Design boilerplate",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "webpack serve --config webpack.config.js",
    "clean": "rimraf dist",
    "production": "cross-env npm run clean && webpack --config webpack.production.config.js --progress --color",
    "lint": "eslint ./app --ext .js,.jsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "precommit": "cross-env npm run lint && npm test",
    "build": "cross-env NODE_ENV=production webpack --config ./webpack.production.config.js --progress --color",
    "prepush": "cross-env npm run lint && npm test",
    "heroku-postbuild": "webpack --config ./webpack.production.config.js --progress"
  },
  "author": "Etor Diaz <etor.diaz.acha@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@ant-design/icons": "^4.2.2",
    "@redux-devtools/extension": "^3.3.0",
    "antd": "^4.24.16",
    "express": "^4.21.1",
    "lodash.get": "^4.4.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^5.3.4",
    "redux": "^5.0.1",
    "redux-saga": "^1.3.0",
    "reqwest": "^2.0.5",
    "reselect": "^4.1.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.24.7",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.25.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "babel-loader": "^9.1.3",
    "babel-plugin-import": "^1.13.8",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-webpack-plugin": "^4.0.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.8.0",
    "react-refresh": "^0.14.2",
    "rimraf": "^5.0.10",
    "sass": "^1.77.8",
    "sass-loader": "^14.1.1",
    "style-loader": "^3.3.4",
    "url-loader": "^4.1.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "\\.(css|less|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "modulePathIgnorePatterns": [
      "core"
    ],
    "moduleDirectories": [
      "node_modules"
    ],
    "bail": true,
    "collectCoverageFrom": [
      "app/**/*.{js,jsx}"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
